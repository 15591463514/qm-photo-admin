# 生产环境配置模板
# Production Environment Configuration Template
#
# 使用说明：
# 1. 复制此文件为 .env.production
# 2. 根据实际情况填写配置值
# 3. 敏感信息（API地址等）请放在 .env.production.local 中
# 4. ⚠️ 生产环境必须使用正确的 API 地址和密钥

# 【生产环境配置】
# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL=/

# API 地址前缀（敏感信息，必须放在 .env.production.local 中）
VITE_API_URL=https://api.yourdomain.com/api/v1

# 是否删除 console（生产环境建议为 true）
VITE_DROP_CONSOLE=true
