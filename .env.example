# 环境变量配置模板
# Environment Variables Configuration Template
#
# 使用说明：
# 1. 复制此文件为 .env
# 2. 根据实际情况填写配置值
# 3. 敏感信息（密钥等）请放在 .env.local 中

# 【通用配置】
# 版本号
VITE_VERSION=3.0.1

# 端口号
VITE_PORT=3006

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL=/

# 权限模式【 frontend 前端模式 / backend 后端模式 】
VITE_ACCESS_MODE=backend

# 跨域请求时是否携带 Cookie（开启前需确保后端支持）
VITE_WITH_CREDENTIALS=false

# 是否打开路由信息
VITE_OPEN_ROUTE_INFO=false

# 锁屏加密密钥（敏感信息，建议放在 .env.local 中）
VITE_LOCK_ENCRYPT_KEY=your_lock_encrypt_key

# 高德地图 API Key（敏感信息，建议放在 .env.local 中）
VITE_AMAP_KEY=your_amap_key

# 高德地图安全密钥（敏感信息，建议放在 .env.local 中）
VITE_AMAP_SECRET=your_amap_secret
