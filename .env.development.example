# 开发环境配置模板
# Development Environment Configuration Template
#
# 使用说明：
# 1. 复制此文件为 .env.development
# 2. 根据实际情况填写配置值
# 3. 敏感信息（API地址、密钥等）请放在 .env.development.local 中

# 【开发环境配置】
# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL=/

# API 请求基础路径（开发环境设置为 / 使用代理，生产环境设置为完整后端地址）
VITE_API_URL=/

# 代理目标地址（开发环境通过 Vite 代理转发请求到此地址，解决跨域问题）
# 注意：敏感信息，建议放在 .env.development.local 中
VITE_API_PROXY_URL=http://localhost:3008

# 是否删除 console（开发环境建议为 false）
VITE_DROP_CONSOLE=false
